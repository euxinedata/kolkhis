[Unit]
Description=Kolkhis Query Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kolkhis-worker
Group=kolkhis-worker
WorkingDirectory=/opt/kolkhis-worker
EnvironmentFile=/etc/kolkhis-worker/env
ExecStart=/opt/kolkhis-worker/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/tmp /opt/kolkhis-worker
PrivateTmp=yes
Environment=HOME=/opt/kolkhis-worker

[Install]
WantedBy=multi-user.target
